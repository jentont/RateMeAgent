# Токен от @BotFather.
BOT_TOKEN=

# Твой Telegram ID (через запятую, если несколько).
ADMIN_IDS=

# Подпись в углу карточки.
BRAND=SOLUTIONS

# Сколько секунд между двумя оценками от одного человека.
RATE_COOLDOWN=10

# --- Батл на призы (мини-апп) ---
# Адрес, где хостинг отдаёт мини-апп (https). Пусто — кнопки «Батл» нет.
WEBAPP_URL=
PORT=8080
# Доля бота с каждого банка, %.
HOUSE_PERCENT=15
# Взнос в турнир недели и деление призов между местами.
TOURNEY_FEE=25
TOURNEY_SPLIT=50,30,20
# Ставки дуэлей профилей и ников.
DUEL_STAKES=10,25,50,100
NICK_STAKES=10,25,50,100

# --- Инлайн и оформление ---
# Склад картинок для инлайна: группа или канал, где бот есть (id вида -100…).
# Пусто — картинки заливаются в личку первого из ADMIN_IDS и сразу удаляются.
STORAGE_CHAT_ID=
# Прокси до Telegram, если он доступен только через VPN (http://127.0.0.1:1080).
PROXY=
# Свой пак эмодзи бот собирает сам (rateme_icons_by_<бот>); владелец — этот
# аккаунт (должен написать боту /start). Пусто — первый из ADMIN_IDS.
PACK_OWNER=
# Готовый пак эмодзи по имени из t.me/addemoji/ИМЯ — тогда бот свой не собирает.
PREMIUM_PACK=
